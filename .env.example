# Password required to open this Postmark instance.
APP_PASSWORD=
# PayPal REST application client id.
PAYPAL_CLIENT_ID=
# PayPal REST application client secret.
PAYPAL_CLIENT_SECRET=
# Use sandbox for testing, live for production.
PAYPAL_ENV=sandbox
# Optional PayPal webhook id used to verify incoming events.
PAYPAL_WEBHOOK_ID=
# OpenRouter API key for label extraction and evidence notes.
OPENROUTER_API_KEY=
# OpenRouter vision model, defaults to google/gemini-2.5-flash.
AI_MODEL=google/gemini-2.5-flash
# Public app URL used for checkout return links.
PUBLIC_URL=http://localhost:8787
# Persistent directory for SQLite and label images.
DATA_DIR=./data
# Sandbox buyer shown in setup instructions.
DEMO_BUYER_EMAIL=
# HTTP server port.
PORT=8787
